# Copy to .env and fill in. Never commit .env (already gitignored).

# Your own Anthropic API key. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Dedicated credentials for the bot's OWN player account (not your account).
# Run `pnpm --filter @border-empires/llm-player create-account` first to
# register it. Any syntactically valid email works for login -- Firebase
# never checks it's a real inbox -- BUT the game's existing attack-alert
# email system (apps/realtime-gateway/src/email-alerts) sends "you're under
# attack" emails to this exact address, and that only reaches you if it's a
# real one you read. Recommended: a real inbox you control, e.g. a Gmail
# +alias like you+llmplayer@gmail.com, so you get pinged even while the bot
# process isn't running.
BOT_EMAIL=llm-player@example.com
BOT_PASSWORD=change-me-to-something-random

# Optional. Posts a summary + journal entry to a Discord channel after each
# session. Create one via a channel's Settings -> Integrations -> Webhooks.
DISCORD_WEBHOOK_URL=

# Optional overrides -- defaults target staging, not production. Point at
# production only once you've watched it behave well on staging.
# GATEWAY_WS_URL=wss://border-empires-combined-staging.fly.dev/ws
# BOT_DISPLAY_NAME=Claude
# TURNS_PER_SESSION=12
# TURN_INTERVAL_MS=4000
