# Example environment configuration for local development.
#
# Copy to `.env` (git-ignored) and fill in values you actually need — nothing
# here is required to run `pnpm dev`. See README.md "Environment Variables"
# for the full table of runtime knobs, and docs/agents/deploys.md for the
# staging/production secret set.

# --- Client (packages/client) ---
# WebSocket target the browser client connects to.
VITE_GATEWAY_WS_URL=ws://localhost:3101/ws
# Auth email that unlocks client-side debug tooling. Leave unset to disable it.
VITE_ADMIN_EMAIL=

# --- Gateway (apps/realtime-gateway) ---
# The one admin identity for gateway-side admin gates (fog toggle, default
# bug-report destination). Leave unset in normal local dev.
ADMIN_EMAIL=
# Bearer token required on /admin/* HTTP routes. Generate a random string
# locally; never reuse a real deployment's token.
ADMIN_API_TOKEN=
# Resend API key for outbound email alerts (bug reports, ownership-change
# notices). Leave unset locally — alert sends no-op without it.
GATEWAY_EMAIL_ALERTS_RESEND_API_KEY=
# Destination inbox for player bug reports/suggestions. Falls back to
# ADMIN_EMAIL if unset.
GATEWAY_BUG_REPORT_EMAIL_TO=
# Optional Slack webhook for slow-login alerting.
GATEWAY_SLOW_LOGIN_ALERT_SLACK_WEBHOOK=

# --- Simulation (apps/simulation) ---
# SQLite path for the durable local world (see `pnpm rewrite:restart:20ai`).
SIMULATION_SQLITE_PATH=
# Optional Slack webhook for ownership-change alerting.
SIMULATION_OWNERSHIP_CHANGE_SLACK_WEBHOOK=

# --- Ops scripts (optional, only needed for staging probes) ---
# Firebase ID token used by scripts/staging-login-latency-probe.mjs.
STAGING_LOGIN_PROBE_AUTH_TOKEN=
# The daily activity digest (scripts/daily-activity-digest.mjs,
# .github/workflows/daily-activity-digest.yml) currently reuses the
# GitHub Actions secret LOAD_HARNESS_SLACK_WEBHOOK; not needed locally.
